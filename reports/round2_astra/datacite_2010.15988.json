{"data":{"id":"10.48550/arxiv.2010.15988","type":"dois","attributes":{"doi":"10.48550/arxiv.2010.15988","prefix":"10.48550","suffix":"arxiv.2010.15988","identifiers":[{"identifier":"2010.15988","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2010.15988"}],"creators":[{"name":"Tinková, Magdaléna","nameType":"Personal","givenName":"Magdaléna","familyName":"Tinková","affiliation":[],"nameIdentifiers":[]},{"name":"Waxman, Ezra","nameType":"Personal","givenName":"Ezra","familyName":"Waxman","affiliation":[],"nameIdentifiers":[]},{"name":"Zindulka, Mikuláš","nameType":"Personal","givenName":"Mikuláš","familyName":"Zindulka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Artin Twin Primes"}],"publisher":"arXiv","container":{},"publicationYear":2020,"subjects":[{"lang":"en","subject":"Number Theory (math.NT)","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"11N05","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2020-10-29T23:16:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2020-11-02T01:06:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2023-01-13T08:57:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2023-01-16T01:07:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2020-10","dateType":"Available","dateInformation":"v1"},{"date":"2020","dateType":"Issued"}],"language":null,"types":{"ris":"RPRT","bibtex":"article","citeproc":"article-journal","schemaOrg":"ScholarlyArticle","resourceType":"Article","resourceTypeGeneral":"Text"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.jnt.2022.10.006","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We say that a prime number $p$ is an $\\textit{Artin prime}$ for $g$ if $g$ mod $p$ generates the group $(\\mathbb{Z}/p\\mathbb{Z})^{\\times}$. For appropriately chosen integers $d$ and $g$, we present a conjecture for the asymptotic number $π_{d,g}(x)$ of primes $p \\leq x$ such that both $p$ and $p+d$ are Artin primes for $g$. In particular, we identify a class of pairs $(d,g)$ for which $π_{d,g}(x) =0$. Our results suggest that the distribution of Artin prime pairs, amongst the ordinary prime pairs, is largely governed by a Poisson binomial distribution.","descriptionType":"Abstract"},{"description":"29 pages; Revised version. Appendix with relevant Mathematica code included. Accepted for publication in the Journal of Number Theory","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2010.15988","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2022-02-24T08:15:08.000Z","registered":"2022-02-24T08:15:10.000Z","published":"2020","updated":"2023-01-16T01:52:02.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2010.15988","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1016/j.jnt.2022.10.006","type":"dois"}]}}}}